# Copy to .env for local development. Never commit the real file.

# Public values (safe in the browser bundle)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Server-side values
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=

# SECRET: server only. Set this in the hosting platform's secret/environment settings
# (for Lovable: Project settings -> Secrets). It bypasses row-level security, so it must
# never be committed, logged or sent to the browser. It is needed by the sign-in and
# booking rate limits (src/lib/auth-throttle.server.ts).
SUPABASE_SERVICE_ROLE_KEY=

# Optional: AI slot recommender
AI_GATEWAY_URL=
AI_GATEWAY_API_KEY=
AI_MODEL=

# SECRET: server only. The service-role / secret key of the Supabase project the website
# signs people in with (the one named in the sign-in token). Used by the Administrator's
# Create login and Reset password tools. Set it as its own secret because the platform's
# SUPABASE_SERVICE_ROLE_KEY can belong to a different backend.
KABU_SERVICE_ROLE_KEY=
